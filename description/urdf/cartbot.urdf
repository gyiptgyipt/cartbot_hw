<?xml version="1.0"?>
<robot name="cartbot">
  <link name="base_link">
    <!-- Bottom frame - front bar -->
    <visual>
      <origin xyz="0 0.19 0.01" rpy="0 0 0"/>
      <geometry>
        <box size="0.5 0.02 0.02"/>
      </geometry>
      <material name="gray">
        <color rgba="0.5 0.5 0.5 1.0"/>
      </material>
    </visual>
    <!-- Bottom frame - back bar -->
    <visual>
      <origin xyz="0 -0.19 0.01" rpy="0 0 0"/>
      <geometry>
        <box size="0.5 0.02 0.02"/>
      </geometry>
      <material name="gray">
        <color rgba="0.5 0.5 0.5 1.0"/>
      </material>
    </visual>
    <!-- Bottom frame - left bar -->
    <visual>
      <origin xyz="0.24 0 0.01" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.4 0.02"/>
      </geometry>
      <material name="gray">
        <color rgba="0.5 0.5 0.5 1.0"/>
      </material>
    </visual>
    <!-- Bottom frame - right bar -->
    <visual>
      <origin xyz="-0.24 0 0.01" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.4 0.02"/>
      </geometry>
      <material name="gray">
        <color rgba="0.5 0.5 0.5 1.0"/>
      </material>
    </visual>

    <!-- Top frame - front bar -->
    <visual>
      <origin xyz="0 0.19 0.21" rpy="0 0 0"/>
      <geometry>
        <box size="0.5 0.02 0.02"/>
      </geometry>
      <material name="gray">
        <color rgba="0.5 0.5 0.5 1.0"/>
      </material>
    </visual>
    <!-- Top frame - back bar -->
    <visual>
      <origin xyz="0 -0.19 0.21" rpy="0 0 0"/>
      <geometry>
        <box size="0.5 0.02 0.02"/>
      </geometry>
      <material name="gray">
        <color rgba="0.5 0.5 0.5 1.0"/>
      </material>
    </visual>
    <!-- Top frame - left bar -->
    <visual>
      <origin xyz="0.24 0 0.21" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.4 0.02"/>
      </geometry>
      <material name="gray">
        <color rgba="0.5 0.5 0.5 1.0"/>
      </material>
    </visual>
    <!-- Top frame - right bar -->
    <visual>
      <origin xyz="-0.24 0 0.21" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.4 0.02"/>
      </geometry>
      <material name="gray">
        <color rgba="0.5 0.5 0.5 1.0"/>
      </material>
    </visual>

    <!-- Vertical bars -->
    <!-- Front-left vertical -->
    <visual>
      <origin xyz="0.24 0.19 0.11" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.02 0.2"/>
      </geometry>
      <material name="gray">
        <color rgba="0.5 0.5 0.5 1.0"/>
      </material>
    </visual>
    <!-- Front-right vertical -->
    <visual>
      <origin xyz="-0.24 0.19 0.11" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.02 0.2"/>
      </geometry>
      <material name="gray">
        <color rgba="0.5 0.5 0.5 1.0"/>
      </material>
    </visual>
    <!-- Back-left vertical -->
    <visual>
      <origin xyz="0.24 -0.19 0.11" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.02 0.2"/>
      </geometry>
      <material name="gray">
        <color rgba="0.5 0.5 0.5 1.0"/>
      </material>
    </visual>
    <!-- Back-right vertical -->
    <visual>
      <origin xyz="-0.24 -0.19 0.11" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.02 0.2"/>
      </geometry>
      <material name="gray">
        <color rgba="0.5 0.5 0.5 1.0"/>
      </material>
    </visual>

    <!-- Collision - simplified as a box -->
    <collision>
      <origin xyz="0 0 0.11" rpy="0 0 0"/>
      <geometry>
        <box size="0.5 0.4 0.22"/>
      </geometry>
    </collision>
  </link>

  <link name="front_left_wheel_link">
    <visual>
      <origin xyz="0 -0.05 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.0504" length="0.043"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 -0.05 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.0504" length="0.043"/>
      </geometry>
    </collision>
  </link>
  <joint name="front_left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="front_left_wheel_link"/>
    <origin xyz="0.15 0.18 0.0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="front_right_wheel_link">
    <visual>
      <origin xyz="0 0.05 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.0504" length="0.043"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0.05 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.0504" length="0.043"/>
      </geometry>
    </collision>
  </link>
  <joint name="front_right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="front_right_wheel_link"/>
    <origin xyz="0.15 -0.18 0.0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="rear_left_caster_link">
    <visual>
      <origin xyz="0 -0.05 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.0504" length="0.043"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 -0.05 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.0504" length="0.043"/>
      </geometry>
    </collision>
  </link>
  <joint name="rear_left_caster_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_left_caster_link"/>
    <origin xyz="-0.15 0.18 0.0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="rear_right_caster_link">
    <visual>
      <origin xyz="0 0.05 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.0504" length="0.043"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0.05 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.0504" length="0.043"/>
      </geometry>
    </collision>
  </link>
  <joint name="rear_right_caster_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_right_caster_link"/>
    <origin xyz="-0.15 -0.18 0.0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>


  <ros2_control name="Ddsm115System" type="system">
    <hardware>
      <plugin>ddsm115_motor_driver_ros2/Ddsm115HardwareInterface</plugin>
      <param name="port_name">/dev/ttyACM0</param>
      <param name="command_deadband">0.001</param>
      <param name="command_change_epsilon">0.001</param>
    </hardware>

    <joint name="front_left_wheel_joint">
      <param name="id">1</param>
      <param name="direction">forward</param>
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="front_right_wheel_joint">
      <param name="id">2</param>
      <param name="direction">forward</param>
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

  </ros2_control>
</robot>
